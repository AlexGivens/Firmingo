+            l->state = response == OFFER ? 1 : 2;
+            l->since_ms = now;
+            l->duration_ms = response == OFFER ? OFFER_MS : LEASE_MS;
+        }
+    }
+    goto done;
+ignored:
+    ++d->ignored;
+done:
